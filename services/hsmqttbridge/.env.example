# HydroServer config
HYDROSERVER_URL=
WORKSPACE_API_KEY=

# MQTT broker config
MQTT_BROKER_URL=
MQTT_BROKER_PORT=
# for subscribing to all topic of same site
MQTT_TOPIC_FILTER = "uwrl/#"
# for subscribing to all topic of same device of device id "mayflylogger"
MQTT_TOPIC_FILTER = "uwrl/mayflylogger/#"
MQTT_CLIENT_ID=
MQTT_KEEPALIVE=
MQTT_USERNAME=
MQTT_PASSWORD=

# Database path:
DB_PATH=

# Logging level
LOG_LEVEL=

# Maximum retry attempts before an observation is marked as failed and ignored for later push to HydroServer
MAX_RETRY_ATTEMPT = 
# time for background retry thread to run
RETRY_INTERVAL = 

# the topic that you want to have them routed to HydroServer 
HYDROSERVER_TOPIC_ROUTES=[""]